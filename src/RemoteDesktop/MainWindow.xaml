<Window x:Class="RemoteDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Personal Remote Desktop" Width="1180" Height="800" MinWidth="920" MinHeight="640" Background="{StaticResource AppBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <TabControl SelectionChanged="TabChanged">
    <TabItem x:Name="ClientTab" Header="원격 접속">
      <DockPanel x:Name="ClientPanel" Margin="12">
        <Grid>
        <Border x:Name="Stage" Background="{StaticResource StageBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12" ClipToBounds="True">
          <Grid>
            <TextBlock x:Name="StageHint" Text="화면을 받는 중…" Visibility="Collapsed" Foreground="{StaticResource StageTextBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True" InputMethod.IsInputMethodEnabled="False" MouseMove="Move" MouseDown="MouseDownRemote" MouseUp="MouseUpRemote" MouseWheel="Wheel" PreviewKeyDown="KeyDownRemote" PreviewKeyUp="KeyUpRemote" GotKeyboardFocus="RemoteFocusChanged" LostKeyboardFocus="ReleaseInput"/>
          </Grid>
        </Border>
        <Border x:Name="ConnectionControls" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720" Margin="24" Style="{StaticResource Card}" Padding="18,16">
          <StackPanel>
            <TextBlock Text="원격 PC에 접속" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,14"/>
            <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="주소" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="포트" Style="{StaticResource FieldLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="비밀번호" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="Address" Grid.Row="1" Grid.Column="0" Text="127.0.0.1" PreviewKeyDown="ClientPasswordKeyDown"/>
            <TextBox x:Name="ClientPort" Grid.Row="1" Grid.Column="2" Text="45831" PreviewKeyDown="ClientPasswordKeyDown"/>
            <PasswordBox x:Name="ClientPassword" Grid.Row="1" Grid.Column="4" PreviewKeyDown="ClientPasswordKeyDown"/>
            <Button x:Name="ConnectButton" Grid.Row="1" Grid.Column="6" Content="접속" Style="{StaticResource PrimaryButton}" MinWidth="104" Click="Connect" VerticalAlignment="Bottom"/>
            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,8,0,0" LastChildFill="True">
              <Button x:Name="ClearPinButton" DockPanel.Dock="Right" Content="지우기" Margin="8,0,0,0" Click="ClearPin" Visibility="Collapsed" ToolTip="저장된 지문을 지웁니다"/>
              <Button x:Name="EditPinButton" DockPanel.Dock="Right" Content="지문 입력" Click="EditPin" ToolTip="서버 지문을 직접 입력합니다"/>
              <TextBlock x:Name="PinSummary" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBox x:Name="ServerPin" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Visibility="Collapsed" PreviewKeyDown="ClientPasswordKeyDown"/>
            <TextBlock x:Name="ClientNoticeText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="7" Text="지문을 비우면 비밀번호만으로 서버 키를 확인합니다." Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel x:Name="RecentPanel" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="7" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock Text="최근 연결" Style="{StaticResource FieldLabel}"/>
              <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
              <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,0" Background="{StaticResource QuietHoverBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="2,2,2,2">
                      <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Address}" Click="UseRecent" Tag="{Binding}" Padding="10,4" MinHeight="28" Background="Transparent" BorderThickness="0" ToolTip="주소와 지문을 채웁니다. 비밀번호는 저장되지 않습니다."/>
                        <Button Content="×" Width="28" MinHeight="28" Padding="0" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" Click="ForgetRecent" Tag="{Binding}" ToolTip="이 최근 연결을 지웁니다"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="SessionToolbar" VerticalAlignment="Top" Visibility="Collapsed" Margin="12,10,12,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" MouseMove="SessionToolbarActivity">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SessionActions" Orientation="Horizontal">
              <ToggleButton x:Name="InputControlToggle" Content="입력 제어" IsChecked="True" IsEnabled="False" Checked="InputControlChanged" Unchecked="InputControlChanged"/>
              <ComboBox x:Name="DisplayList" Width="156" Visibility="Collapsed" IsEnabled="False" SelectionChanged="DisplayChanged" DropDownClosed="DisplayListClosed" DisplayMemberPath="Name" Margin="8,0,0,0"/>
              <Button x:Name="SessionMenuButton" Content="조작" IsEnabled="False" Click="OpenSessionMenu" Margin="8,0,0,0">
                <Button.ContextMenu>
                  <ContextMenu x:Name="SessionMenu" Closed="SessionMenuClosed">
                    <MenuItem Header="화면 품질">
                      <MenuItem Header="저대역폭" Tag="30" Click="QualityMenuChanged"/>
                      <MenuItem Header="균형" Tag="55" Click="QualityMenuChanged"/>
                      <MenuItem Header="고화질" Tag="75" Click="QualityMenuChanged"/>
                    </MenuItem>
                    <MenuItem Header="최대 FPS">
                      <MenuItem Header="5 FPS" Tag="5" Click="FrameRateMenuChanged"/>
                      <MenuItem Header="10 FPS" Tag="10" Click="FrameRateMenuChanged"/>
                      <MenuItem Header="15 FPS" Tag="15" Click="FrameRateMenuChanged"/>
                      <MenuItem Header="30 FPS" Tag="30" Click="FrameRateMenuChanged"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="ClipboardAutoMenu" Header="클립보드 자동 동기화" IsCheckable="True" Checked="ClipboardAutoChanged" Unchecked="ClipboardAutoChanged"/>
                    <MenuItem Header="클립보드 지금 보내기" Click="ClipboardSend"/>
                    <MenuItem Header="클립보드 지금 받기" Click="ClipboardReceive"/>
                    <Separator/>
                    <MenuItem Header="한/영 전환" Click="ToggleKorean"/>
                    <MenuItem Header="모니터 새로고침" Click="RefreshDisplays"/>
                    <MenuItem Header="전체화면 (F11)" Click="ToggleFullscreen"/>
                    <MenuItem Header="세션 정보" Click="ShowSessionInfo"/>
                    <MenuItem Header="연결 종료" Click="Disconnect"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <TextBlock x:Name="SessionPresetText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="준비됨" Margin="14,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <TextBlock x:Name="HealthText" Text="연결 전" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <Button x:Name="EndSessionButton" Content="연결 종료" IsEnabled="False" Click="Disconnect" Foreground="{StaticResource DangerBrush}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Button x:Name="SessionReveal" Content="측정 중" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,4" MinHeight="28" Click="RevealSessionToolbar" ToolTip="세션 조작 열기"/>
        <Border x:Name="SessionAlert" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,16" MaxWidth="520" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" IsHitTestVisible="False">
          <TextBlock x:Name="SessionAlertText" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Border>
        <Border x:Name="InputHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,16" MaxWidth="520" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" IsHitTestVisible="False">
          <TextBlock x:Name="InputHintText" Foreground="{StaticResource InkBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
            <Border x:Name="SessionInfoCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" MaxWidth="420" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="닫기" Click="CloseSessionInfo" VerticalAlignment="Top" Margin="12,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="세션 정보" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,6"/>
                  <TextBlock x:Name="SessionInfoText" Style="{StaticResource BodyText}"/>
                </StackPanel>
              </DockPanel>
            </Border>
        </Grid>
      </DockPanel>
    </TabItem>
    <TabItem x:Name="ServerTab" Header="이 PC">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24" MaxWidth="980" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="520"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*" MaxWidth="420"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="HostStateMark" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="접속 받기" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ServerStatusText" Text="준비됨" Style="{StaticResource BodyText}" Margin="0,8,0,16" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="HostNoticeText" Visibility="Collapsed" Style="{StaticResource BodyText}" Margin="0,-8,0,12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="PasswordState" Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                <Button x:Name="ChangePasswordButton" Content="비밀번호 변경" Click="ChangeHostPassword" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <StackPanel x:Name="PasswordEditor">
                  <TextBlock x:Name="HostPasswordInstruction" Text="접속 비밀번호 (8자 이상, 한 번 저장하면 계속 사용)" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="HostPassword" Margin="0,0,0,10" PreviewKeyDown="HostPasswordKeyDown"/>
                  <Button x:Name="SaveHostPasswordButton" Content="비밀번호 저장" Style="{StaticResource PrimaryButton}" Click="SaveHostPassword" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                </StackPanel>
                <TextBlock Text="포트" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="HostPort" Text="45831" Width="140" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <CheckBox x:Name="SmoothHostToggle" Content="끊김 줄이기" IsChecked="True" Margin="0,0,0,16" Checked="SmoothHostChanged" Unchecked="SmoothHostChanged" ToolTip="화면이 거의 그대로일 때 이전 프레임을 다시 사용해 끊김을 줄입니다."/>
                <WrapPanel>
                  <Button x:Name="StartButton" Content="접속 대기 시작" Style="{StaticResource PrimaryButton}" Click="StartHost" Margin="0,0,8,8"/>
                  <Button x:Name="StopButton" Content="서버 중지" Click="StopHost" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,8"/>
                  <Button x:Name="KickButton" Content="현재 접속 끊기" Click="Kick" IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="이 PC에 접속하려면" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
              <TextBlock Text="상대 PC의 주소 칸에 붙여 넣으면 포트도 같이 들어갑니다. 비밀번호만 맞으면 수락 없이 연결됩니다." Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16"/>
              <TextBlock Text="주소" Style="{StaticResource FieldLabel}"/>
              <TextBlock x:Name="AddressEmpty" Text="표시할 네트워크 주소가 없습니다." Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" Margin="0,0,0,16"/>
              <ItemsControl x:Name="AddressList" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8" LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="복사" MinWidth="64" Margin="8,0,0,0" Click="CopyAddress" Tag="{Binding}" ToolTip="주소와 포트를 복사합니다"/>
                      <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Cascadia Mono, Consolas"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="서버 지문" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="ToggleFingerprintButton" DockPanel.Dock="Right" Content="지문 보기" Click="ToggleFingerprint" Margin="8,0,0,0" ToolTip="64자리 지문 전체를 표시합니다"/>
                <Button Content="지문 복사" DockPanel.Dock="Right" Click="CopyFingerprint" ToolTip="지문 전체를 복사합니다"/>
                <TextBlock x:Name="FingerprintSummary" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBox x:Name="Fingerprint" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,0,0,16"/>
              <TextBlock Text="같은 LAN 또는 VPN에서 사용합니다. 탐색기에서 복사한 파일과 텍스트는 연결된 동안 상대 클립보드로 전달됩니다." Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
